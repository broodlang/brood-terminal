;; Tests for the terminal UI reducer + renderer (term.blsp). The edit line is an
;; `editor/lineedit` state on the tab's `:edit` (in `:path` word mode), so editing
;; is driven through `update` with key inputs and asserted via `edit-text`.
(defmodule term-test (:use term) (:use test))

(defn type-str (m s) (fold (string/->list s) m (fn (acc ch) (update acc ch 80 24))))
(defn feed (m keys) (fold keys m (fn (acc k) (update acc k 80 24))))
(defn fresh () {:tabs [(new-tab "/a/b")] :active 0 :done false})
(defn line (m) (edit-text (active-tab m)))

(describe "line editing"
  (test "typing accumulates into the edit line"
    (assert= (line (type-str (fresh) "hello")) "hello"))
  (test "backspace deletes before the cursor"
    (assert= (line (update (type-str (fresh) "hi") :backspace 80 24)) "h"))
  (test "left then backspace deletes mid-line"
    (assert= (line (feed (type-str (fresh) "ab") [:left :backspace])) "b"))
  (test "C-a then C-e jump to the line's ends"
    (let (m (feed (type-str (fresh) "bc") [:ctrl-a "a"]))
      (assert= (line m) "abc")
      (assert= (get (get (active-tab m) :edit) :point) 1)))
  (test "kill (C-u) then yank (C-y) round-trips the line"
    (assert= (line (feed (type-str (fresh) "cat /tmp/x") [:ctrl-u :ctrl-y])) "cat /tmp/x")))

(describe "path word mode (:word-mode :path)"
  (test "M-b moves back one path component, not the whole path"
    (let (m (feed (type-str (fresh) "cat /usr/share/dict") [:alt-b]))
      (assert= (get (get (active-tab m) :edit) :point) (string/length "cat /usr/share/"))))
  (test "C-w kills only the trailing path component"
    (assert= (line (feed (type-str (fresh) "cat /usr/share") [:ctrl-w])) "cat /usr/")))

(describe "submit + history"
  (test "enter clears the edit line and records history"
    (let (m (update (type-str (fresh) "pwd") :enter 80 24)
          t (active-tab m))
      (assert= (edit-text t) "")
      (assert= (get t :history) ["pwd"])))
  (test "up-arrow recalls the last command"
    (assert= (line (feed (type-str (fresh) "pwd") [:enter :up])) "pwd"))
  (test "C-r reverse-search recalls a matching command"
    (let (m (feed (type-str (feed (type-str (fresh) "pwd") [:enter]) "echo hi")
              [:enter :ctrl-r "p"]))
      (assert= (line m) "pwd")))
  (test "cd updates the tab cwd"
    (let (m0 {:tabs [(new-tab "/usr/share")] :active 0 :done false}
          m (update (type-str m0 "cd ..") :enter 80 24))
      (assert= (get (active-tab m) :cwd) "/usr"))))

(describe "cancel + close"
  (test "ctrl-c echoes ^C and re-prompts with the line cleared"
    (let (m (update (type-str (fresh) "oops") :ctrl-c 80 24))
      (assert= (line m) "")
      (is (not (get m :done)))))
  (test "ctrl-d on an empty line closes the last tab (quit)"
    (is (get (update (fresh) :ctrl-d 80 24) :done)))
  (test "ctrl-d mid-line deletes forward instead of closing"
    (let (m (feed (type-str (fresh) "ab") [:ctrl-a :ctrl-d]))
      (is (not (get m :done)))
      (assert= (line m) "b"))))

(describe "tabs"
  (test "ctrl-t opens and focuses a new tab"
    (let (m (update (fresh) :ctrl-t 80 24))
      (assert= (count (get m :tabs)) 2)
      (assert= (get m :active) 1)))
  (test "alt-1 switches to the first tab"
    (let (m (feed (fresh) [:ctrl-t :alt-1]))
      (assert= (get m :active) 0)))
  (test "ctrl-d with two tabs closes one"
    (let (m (feed (fresh) [:ctrl-t :ctrl-d]))
      (assert= (count (get m :tabs)) 1)
      (is (not (get m :done)))))
  (test "ctrl-w kills a word, it no longer closes the tab"
    (let (m (update (type-str (fresh) "word") :ctrl-w 80 24))
      (assert= (count (get m :tabs)) 1)
      (is (not (get m :done)))
      (assert= (line m) ""))))

(defn last-line-text (m)
  ;; first span's string of the active tab's last scrollback line
  (let (lns (get (active-tab m) :lines))
    (first (nth (nth lns (dec (count lns))) 0))))

(defn model-with-job (jid pid)
  {:tabs [(assoc (new-tab "/x") :jobs (list {:id jid :pid pid :line "sleep 1"}))]
   :active 0
   :done false
   :tick-ms 120
   :next-job (inc jid)
   :spin 0
   :now 0})

(describe "background jobs"
  (test "an external command becomes a background job, not a blocking call"
    ;; `$` is a shell metacharacter, so this goes external → spawns a worker.
    (let (m (update (type-str (fresh-model) "echo $HOME") :enter 80 24)
          t (active-tab m))
      (assert= (count (get t :jobs)) 1)
      (assert= (get (first (get t :jobs)) :line) "echo $HOME")
      (assert= (edit-text t) "") ; prompt is live again immediately
      (assert= (get t :history) ["echo $HOME"])
      (assert= (get m :tick-ms) 120))) ; beat speeds up while running
  (test "a built-in stays inline (runs synchronously, no job)"
    (let (m (update (type-str (fresh-model) "pwd") :enter 80 24))
      (is (empty? (get (active-tab m) :jobs)))))
  (test "a finished worker's :cmd-done folds output in and clears the job"
    (let (m (update (model-with-job 7 (self))
              [:cmd-done 7 {:lines (list (list ["job output" nil]))}]
              80
              24)
          t (active-tab m))
      (is (empty? (get t :jobs)))
      (assert= (last-line-text m) "job output")
      (assert= (get m :tick-ms) 60000))) ; back to idle when nothing runs
  (test ":cmd-done for an unknown job id is ignored"
    (let (m (model-with-job 7 (self)))
      (assert= (count (get (active-tab (update m [:cmd-done 99 {:lines nil}] 80 24)) :jobs)) 1)))
  (test ":tick advances the spinner frame"
    (assert= (get (update (model-with-job 7 (self)) :tick 80 24) :spin) 1))
  (test "ctrl-c cancels running jobs instead of the edit line"
    (let (p (spawn (sleep 100000))
          m (update (model-with-job 1 p) :ctrl-c 80 24))
      (is (empty? (get (active-tab m) :jobs)))
      (is (not (get m :done)))))
  (test "view renders running-job spinners without crashing"
    (is (vector? (view (model-with-job 7 (self)) 80 24)))))

(describe "view"
  (test "renders a frame (vector of ops)"
    (is (vector? (view (fresh) 80 24))))
  (test "survives a tiny terminal without crashing"
    (is (vector? (view (fresh) 10 4)))))
