;; src/term.blsp — the tabbed terminal UI for brood-terminal.
;;
;; A `ui-run` (TEA) app over the display seam (ADR-046): a pure `view`
;; (model + size → a render frame) and an `update` (model + input → model).
;; The "shell" it drives is `commands.blsp` — there is no bash/PTY behind it
;; (the runtime has no pseudo-terminal), so each tab is a Brood mini-shell.
;;
;; MODEL  {:tabs [tab ...] :active n :done bool :tick-ms ms
;;         :next-job n :spin n :now ms}       ; background-job counter + spinner/clock
;; TAB    {:cwd "/…" :lines [span-line ...]   ; scrollback (a VECTOR)
;;         :edit <lineedit state>             ; the edit line (editor/lineedit, :path word mode)
;;         :history [str ...]                 ; oldest-first, for the `history` builtin
;;         :scroll n                          ; lines scrolled up from the bottom
;;         :jobs (job ...)}                    ; running background commands (see below)
;; A SPAN-LINE is a list of spans `[string face]` (see commands.blsp).
;; A JOB is `{:id n :pid <worker> :line "…" :started ms}` — an external command
;; running in a spawned process; its `[:cmd-done id result]` reply lands as input.
;;
;; The edit line is a `editor/lineedit` state (text + point + kill-ring + its own
;; newest-first history + reverse-search), in `:path` word mode so M-b/M-f/C-w/M-d
;; move and kill one path component at a time. Tab-level keys (Ctrl-T/Alt-1..9/
;; PgUp/Dn/Tab-complete/Ctrl-L) are intercepted in `handle-key`; everything else
;; flows through `lineedit-handle`, and its `:done` drives submit / cancel / close.

(defmodule term
  "The tabbed terminal UI for brood-terminal — a `ui-run` app whose tabs each run
the `commands` mini-shell. `(start)` launches it on the terminal frontend."
  (:use commands :exclude [ln])
  (:use editor/display)
  (:use editor/ui))

(def *max-lines* 4000)

(def *alt-tab*
  {:alt-1 0 :alt-2 1 :alt-3 2 :alt-4 3 :alt-5 4 :alt-6 5 :alt-7 6 :alt-8 7 :alt-9 8})

;; ---- background jobs --------------------------------------------------------
;; External commands block (the runtime has no PTY; `run-process` waits for the
;; child to exit), so running them on the UI process would freeze the whole app.
;; Instead `submit` spawns a worker green process per external command; the worker
;; runs it and `send`s `[:cmd-done jid result]` back to the UI process's mailbox,
;; which `with-jobs` surfaces as loop input (the `with-events` idiom). So commands
;; run concurrently in the background, Claude-CLI style: the prompt stays live,
;; each running job shows a spinner + elapsed time, and its output lands when done.

(def *spinner* ["⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏"])
(def *f-run* {:fg :yellow :bold true})
(def *idle-tick* 60000) ; poll beat when nothing is running (just the refresh tick)
(def *busy-tick* 120) ; while a job runs: animate the spinner + drain the mailbox
(defn spin-frame (spin) (nth *spinner* (math/mod spin (count *spinner*))))

;; ---- string helpers ---------------------------------------------------------

(defn- rindex-at
  (s ch i)
  (cond
    (< i 0) -1
    (= (string/char-at s i) ch) i
    else (rindex-at s ch (dec i))))

(defn rindex (s ch)
  "Index of the last occurrence of 1-char `ch` in `s`, or -1."
  (rindex-at s ch (dec (string/length s))))

(defn basename (p)
  (let (i (rindex p "/"))
    (if (< i 0)
      p
      (let (b (string/substring p (+ i 1) (string/length p)))
        (if (= b "") "/" b)))))

;; ---- tab / model accessors --------------------------------------------------

(defn fresh-edit (hist)
  "A fresh edit-line state seeded with newest-first history `hist`, in `:path` word
mode (M-b/M-f/C-w/M-d move and kill by path component)."
  (assoc (editor/lineedit/lineedit-init "" "" hist) :word-mode :path))

(defn edit-text (t)
  "The tab's current edit-line text."
  (get (get t :edit) :text))

(defn set-line (t s)
  "The tab with its edit line replaced by `s`, point at the end."
  (let (e (get t :edit))
    (assoc t :edit (assoc e :text s :point (string/length s) :hist-idx -1))))

(defn new-tab (cwd)
  {:cwd cwd :lines (welcome) :edit (fresh-edit '()) :history [] :scroll 0 :jobs '()})

(defn welcome ()
  [(list ["  brood-terminal " *f-head*] ["— a Brood mini-shell (built-ins, no bash)" *f-dim*])
    (list ["  type " *f-dim*]
      ["help"
        {:fg :cyan
         :bold true}]
      [" for commands, or " *f-dim*]
      ["ls"
        {:fg :cyan
         :bold true}]
      [" to look around." *f-dim*])
    (list ["" nil])])

(defn active-tab (model) (nth (get model :tabs) (get model :active)))

(defn update-active (model f)
  (let (i (get model :active))
    (assoc model :tabs (assoc (get model :tabs) i (f (active-tab model))))))

(defn cap-lines (v)
  (let (n (count v))
    (if (> n *max-lines*) (seq/subvec v (- n *max-lines*) n) v)))

(defn prompt-str (tab) (str (short-cwd (get tab :cwd)) " $ "))
(defn prompt-spans (tab) (list [(prompt-str tab) *f-prompt*]))
(defn tab-title (tab) (basename (short-cwd (get tab :cwd))))

;; ---- Tab completion (filesystem path completion of the trailing token) ------

(defn complete (t)
  (let (input (edit-text t)
        sp (rindex input " ")
        head (if (< sp 0) "" (string/substring input 0 (+ sp 1)))
        token (if (< sp 0) input (string/substring input (+ sp 1) (string/length input)))
        slash (rindex token "/")
        dirp (if (< slash 0) "" (string/substring token 0 (+ slash 1)))
        base (if (< slash 0) token (string/substring token (+ slash 1) (string/length token)))
        sdir (resolve-path (get t :cwd) (if (= dirp "") "." dirp))
        ents (if (file/dir? sdir) (sort (file/ls sdir)) nil)
        ms (filter (fn (e) (string/starts-with? e base)) ents))
    (cond
      (or (nil? ms) (empty? ms)) t
      (= (count ms) 1)
        (let (m (first ms)
              suffix (if (file/dir? (resolve-path sdir m)) "/" " "))
          (set-line t (str head dirp m suffix)))
      else
        (let (cp (editor/highlight/common-prefix ms)
              opts (list [(string/join "  " ms) *f-dim*]))
          (assoc (set-line t (str head dirp cp))
            :lines (cap-lines (into (get t :lines) [opts])))))))

;; ---- tab management ---------------------------------------------------------

(defn add-tab (model)
  (let (tabs (get model :tabs))
    (assoc model
      :tabs (into tabs [(new-tab (get (active-tab model) :cwd))])
      :active (count tabs))))

(defn close-tab (model)
  (let (tabs (get model :tabs) i (get model :active))
    (if (<= (count tabs) 1)
      (assoc model :done true)
      (let (tabs2 (seq/remove-nth i tabs))
        (assoc model :tabs tabs2 :active (math/min i (dec (count tabs2))))))))

(defn goto-tab (model n)
  (if (and (>= n 0) (< n (count (get model :tabs)))) (assoc model :active n) model))

(defn scroll-by (model delta)
  (update-active model (fn (t) (assoc t :scroll (math/max 0 (+ (get t :scroll 0) delta))))))

(defn cancel-line (t)
  (let (echo (append (prompt-spans t) (list [(str (edit-text t) "^C") nil])))
    (assoc t
      :lines (cap-lines (into (get t :lines) [echo]))
      :edit (fresh-edit (get (get t :edit) :hist))
      :scroll 0)))

;; ---- background-job bookkeeping ---------------------------------------------

(defn any-jobs? (model)
  "True if any tab has a running background job — drives the poll beat."
  (fold (fn (acc t) (or acc (not (empty? (get t :jobs))))) false (get model :tabs)))

(defn refresh-tick (model)
  "Set the poll beat: fast while a job runs (spinner + mailbox drain), idle otherwise."
  (assoc model :tick-ms (if (any-jobs? model) *busy-tick* *idle-tick*)))

(defn job-has? (jobs jid)
  "True if `jobs` contains a job with id `jid`."
  (not (empty? (filter (fn (j) (= (get j :id) jid)) jobs))))

(defn tab-index-with-job (model jid)
  "Index of the tab whose `:jobs` carries job id `jid`, or nil. Found by id (not by
the active tab) because the job may finish after the user switched/added tabs."
  (let (hit (filter (fn ([_ t]) (job-has? (get t :jobs) jid)) (seq/enumerate (get model :tabs))))
    (if (empty? hit) nil (first (first hit)))))

(defn job-done (model ev)
  "Fold a worker's `[:cmd-done jid result]` reply into the model: drop the job from its
tab and append the captured output. A non-existent jid (cancelled tab) is ignored."
  (let (jid (nth ev 1)
        result (nth ev 2)
        ti (tab-index-with-job model jid))
    (if (nil? ti)
      model
      (let (tabs (get model :tabs)
            tab (nth tabs ti)
            jobs2 (filter (fn (j) (not (= (get j :id) jid))) (get tab :jobs))
            outlns (get result :lines)
            lines2 (cap-lines (into (get tab :lines) (into [] (or outlns nil))))
            tab2 (assoc tab :jobs jobs2 :lines lines2))
        (refresh-tick (assoc model :tabs (assoc tabs ti tab2)))))))

(defn on-tick (model)
  "The refresh beat: advance the spinner frame and stamp `:now` so the elapsed-time
readout next to a running job ticks up. `view` reads `:now`/`:spin` (stays pure)."
  (assoc model :spin (inc (get model :spin 0)) :now (os/now)))

(defn cancel-jobs (model)
  "Ctrl-C with jobs running in the active tab: kill the worker processes and note the
cancellation. (The orphaned `/bin/sh` child keeps running detached — no PTY to signal
it; its output is just discarded. See ROADMAP.md.)"
  (let (i (get model :active)
        tab (active-tab model)
        jobs (get tab :jobs))
    (doseq (j jobs) (exit (get j :pid) :kill))
    (let (notes (map (fn (j) (list ["^C " *f-dim*] [(get j :line) *f-dim*])) jobs)
          lines2 (cap-lines (into (get tab :lines) (into [] notes)))
          tab2 (assoc tab :jobs '() :lines lines2 :scroll 0))
      (refresh-tick (assoc model :tabs (assoc (get model :tabs) i tab2))))))

;; ---- submit (run the typed command) -----------------------------------------

(defn submit-inline (model i tab input res echo)
  "Apply an instant command's result (`cd`/built-in/Brood eval) to the model — the
original synchronous path: honour `:exit`/`:clear`/`:cwd`, append output, re-prompt."
  (if (get res :exit)
    (close-tab model)
    (let (cwd (get tab :cwd)
          new-cwd (get res :cwd cwd)
          outlns (get res :lines)
          base (if (get res :clear)
                 []
                 (into (into (get tab :lines) [echo]) (into [] (or outlns nil))))
          hist (if (string/blank? input) (get tab :history) (into (get tab :history) [input]))
          tab2 (assoc tab
                 :lines (cap-lines base)
                 :cwd new-cwd
                 :history hist
                 :edit
                   (fresh-edit (editor/lineedit/lineedit-remember (get (get tab :edit) :hist) input))
                 :scroll 0))
      (assoc model :tabs (assoc (get model :tabs) i tab2)))))

(defn submit-external (model i tab input line ctx echo)
  "Launch an external command as a background job: echo it now, spawn a worker that
runs it off the UI process and `send`s `[:cmd-done jid result]` back, and re-prompt
immediately so the user keeps working while it runs."
  (let (jid (get model :next-job)
        me (self)
        pid (spawn (send me [:cmd-done jid (run-external line ctx)]))
        job {:id jid :pid pid :line line :started (os/now)}
        hist (if (string/blank? input) (get tab :history) (into (get tab :history) [input]))
        tab2 (assoc tab
               :lines (cap-lines (into (get tab :lines) [echo]))
               :jobs (cons job (get tab :jobs))
               :history hist
               :edit
                 (fresh-edit (editor/lineedit/lineedit-remember (get (get tab :edit) :hist) input))
               :scroll 0))
    (refresh-tick (assoc model
                    :tabs (assoc (get model :tabs) i tab2)
                    :next-job (inc jid)
                    :now (os/now)))))

(defn submit (model cols rows)
  "Run the typed line. Built-ins / `cd` / `(brood …)` run inline (instant, and `cd`
mutates shell state that must stay ordered); external commands become background
jobs so a slow one never freezes the UI."
  (let (i (get model :active)
        tab (active-tab model)
        input (edit-text tab)
        cwd (get tab :cwd)
        echo (append (prompt-spans tab) (list [input nil]))
        ctx {:cwd cwd :cols cols :history (get tab :history)})
    (match (plan-command input ctx)
      ([:inline res] (submit-inline model i tab input res echo))
      ([:external line] (submit-external model i tab input line ctx echo)))))

;; ---- update (input → model) -------------------------------------------------

(defn handle-mouse (model ev)
  ;; ev is `[:mouse action button row col mods]`; we only act on the wheel.
  (let (action (if (>= (count ev) 2) (nth ev 1) nil))
    (cond
      (= action :scroll-up) (scroll-by model 3)
      (= action :scroll-down) (scroll-by model -3)
      else model)))

(defn edit-key (model input cols rows)
  "Fold one key into the active tab's edit line via lineedit — typing, motion,
kill/yank (path-component word ops), ↑/↓ history, C-r reverse-search. `:done`
drives the shell: `:submit` (Enter) runs the line, `:cancel` (C-c) echoes `^C`
and re-prompts, `:eof` (C-d on an empty line) closes the tab, shell-style."
  (let (edit (editor/lineedit/lineedit-handle (get (active-tab model) :edit) input)
        done (get edit :done))
    (cond
      (= done :submit) (submit model cols rows)
      (= done :cancel)
        (if (empty? (get (active-tab model) :jobs))
          (update-active model cancel-line)
          (cancel-jobs model))
      (= done :eof) (close-tab model)
      else (update-active model (fn (t) (assoc t :edit edit :scroll 0))))))

(defn handle-key (model input cols rows)
  (let (page (math/max 1 (- rows 4)))
    (cond
      (= input :tab) (update-active model complete)
      (= input :ctrl-l) (update-active model (fn (t) (assoc t :lines [] :scroll 0)))
      (= input :ctrl-t) (add-tab model)
      (= input :back-tab) (goto-tab model (dec (get model :active)))
      (= input :page-up) (scroll-by model page)
      (= input :page-down) (scroll-by model (- page))
      ;; raw-mode Enter aliases: a piped/scripted `\n` arrives as :ctrl-j (and `\r`
      ;; can arrive as :ctrl-m) — treat them as Enter so scripted input submits.
      (or (= input :ctrl-j) (= input :ctrl-m)) (edit-key model :enter cols rows)
      else (edit-key model input cols rows))))

(defn update (model input cols rows)
  "Fold one input event into the model (the `ui-run` update fn). `:tick` advances the
spinner; `[:cmd-done jid result]` is a finished background command (a worker process's
mailbox reply, surfaced as input by `with-jobs`). Vector inputs are otherwise the mouse
(`[:mouse …]`); a GUI window's `[:resize …]` is ignored here and picked up via the
frontend's `:size` on the next frame. Tab-level keys (Ctrl-T, Alt-1..9, Tab, Ctrl-L,
PgUp/Dn) are handled here; everything else — including Ctrl-W, which now kills a path
component like every shell — drives the lineedit edit line."
  (cond
    (= input :tick) (on-tick model)
    (and (vector? input) (= (first input) :cmd-done)) (job-done model input)
    (and (vector? input) (= (first input) :mouse)) (handle-mouse model input)
    (vector? input) model
    (contains? *alt-tab* input) (goto-tab model (get *alt-tab* input))
    else (handle-key model input cols rows)))

;; ---- view (model → frame) ---------------------------------------------------

(defn- draw-spans-acc
  (row col spans cols acc)
  (if (or (empty? spans) (>= col cols))
    (reverse acc)
    (let ([s face] (first spans)
          avail (- cols col)
          s2 (if (> (string/length s) avail) (string/substring s 0 avail) s))
      (if (= s2 "")
        (draw-spans-acc row col (rest spans) cols acc)
        (draw-spans-acc row
          (+ col (string/length s2))
          (rest spans)
          cols
          (cons (text row col s2 face) acc))))))

(defn draw-spans (row col spans cols)
  "Render op list for `spans` laid left-to-right from `col`, clipped at `cols`."
  (draw-spans-acc row col spans cols nil))

(defn render-window (window cols)
  (mapcat (fn ([i line]) (draw-spans (+ 1 i) 0 line cols)) (seq/enumerate window)))

(defn- draw-tabs-acc
  (tabs idx active spin col cols acc)
  (if (or (empty? tabs) (>= col cols))
    (reverse acc)
    (let (tab (first tabs)
          busy (if (empty? (get tab :jobs)) "" (str " " (spin-frame spin)))
          label (str " " (+ idx 1) ":" (tab-title tab) busy " ")
          face (if (= idx active) {:bg :white :fg :black :bold true} {:bg :blue :fg :white})
          w (string/length label)
          shown (if (> (+ col w) cols) (string/substring label 0 (- cols col)) label))
      (draw-tabs-acc (rest tabs)
        (+ idx 1)
        active
        spin
        (+ col w)
        cols
        (cons (text 0 col shown face) acc)))))

(defn draw-tabs (tabs idx active spin col cols)
  (draw-tabs-acc tabs idx active spin col cols nil))

(defn render-tabbar (model cols)
  (cons (bar 0 cols "" {:face {:bg :blue}})
    (draw-tabs (get model :tabs) 0 (get model :active) (get model :spin 0) 0 cols)))

(defn render-status (cols rows scroll)
  (let (hint " Ctrl-T tab · Ctrl-D close · Alt-1-9 switch · Tab complete · ↑/C-r history · PgUp/Dn scroll · help · exit"
        msg (if (> scroll 0) (str hint "   [scrolled +" scroll "]") hint))
    (bar (- rows 1) cols msg {:face {:reverse true}})))

(defn elapsed-str (os/now started)
  "`now - started` (ms) as a `12.3s` readout (tenths), never negative."
  (let (el (math/max 0 (- os/now started)))
    (str (math/quot el 1000) "." (math/mod (math/quot el 100) 10) "s")))

(defn job-status-line (os/now spin job)
  "One spinner line for a running job: `⠋ <command>   12.3s`."
  (list [(str (spin-frame spin) " ") *f-run*]
    [(get job :line) nil]
    [(str "   " (elapsed-str os/now (get job :started 0))) *f-dim*]))

(defn job-status-lines (model tab)
  "The active tab's running jobs as spinner lines (newest first), shown just above
the prompt — the live, Claude-CLI-style view of what's running in this tab."
  (let (os/now (get model :now 0)
        spin (get model :spin 0))
    (map (fn (j) (job-status-line os/now spin j)) (get tab :jobs))))

(defn view (model cols rows)
  "Render the model to a frame: tab bar (row 0), scrollback, running-job spinners,
edit line, status bar. While reverse-searching, the edit line shows lineedit's
`(reverse-i-search)` prompt."
  (let (tab (active-tab model)
        height (math/max 1 (- rows 2))
        search-p (editor/lineedit/lineedit-display-prompt (get tab :edit))
        pstr (if (= search-p "") (prompt-str tab) search-p)
        plen (string/length pstr)
        input (edit-text tab)
        curs (get (get tab :edit) :point)
        ilen (string/length input)
        visw (math/max 1 (- cols plen))
        hoff (if (< curs visw) 0 (+ (- curs visw) 1))
        shown (string/substring input hoff (math/min ilen (+ hoff visw)))
        pline (list [pstr *f-prompt*] [shown nil])
        jobls (into [] (job-status-lines model tab))
        vlines (into (into (get tab :lines) jobls) [pline])
        total (count vlines)
        scroll (math/min (get tab :scroll 0) (math/max 0 (- total height)))
        start (math/max 0 (- total height scroll))
        window (take height (drop start vlines))
        body (render-window window cols)
        curop (if (= scroll 0)
                (let (row (+ 1 (- (dec total) start))
                      col (math/min (dec cols) (+ plen (- curs hoff))))
                  (if (and (>= row 1) (<= row (- rows 2))) (cursor row col) nil))
                nil)
        ops (append (list (clear))
              (render-tabbar model cols)
              body
              (list (render-status cols rows scroll))
              (if curop (list curop) nil)))
    (apply frame ops)))

;; ---- entry ------------------------------------------------------------------

(defn fresh-model ()
  (let (dir (file/cwd))
    {:tabs [(new-tab dir)]
     :active 0
     :done false
     :tick-ms *idle-tick*
     :next-job 1
     :spin 0
     :now 0}))

(defn with-jobs (display)
  "Wrap `display` so its `:poll` first delivers any queued `[:cmd-done …]` worker reply
(this process's mailbox) as loop input, else polls `display` as usual — the same seam
`editor/ui/with-events` uses for SSE. So a finished background command reaches `update`
as an event: on the GUI the loop is already parked in a mailbox `receive`, so it wakes
the instant the worker replies (no polling); on the terminal the short busy-tick beat
drains the mailbox between blocking keyboard reads."
  (assoc display
    :poll
      (fn (ms)
        (let (ev (receive ([:cmd-done jid r] [:cmd-done jid r]) (after 0 nil)))
          (if (nil? ev) ((get display :poll) ms) ev)))))

(defn start-term ()
  "Launch on the terminal frontend (needs a host TTY). Blocks until the last tab
is closed — Ctrl-W on the final tab, or `exit`."
  (ui-run (fresh-model) view update (with-jobs *term-display*)))

(defn start-gui ()
  "Launch in a native window (`--features gui` build) — no host terminal needed.
Close the window's X, Ctrl-W the last tab, or `exit` to quit."
  (ui-run (fresh-model) view update (with-jobs (gui-display))))

(defn start ()
  "Launch brood-terminal in a native window (the default — no host TTY required).
Use `(start-term)` to run inside an existing terminal instead."
  (start-gui))
